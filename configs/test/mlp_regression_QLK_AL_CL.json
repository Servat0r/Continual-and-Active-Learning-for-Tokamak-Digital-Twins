{
  "general": {
    "mode": "AL(CL)",
    "task": "regression",
    "dtype": "float32",
    "num_campaigns": 5,
    "train_mb_size": 4096,
    "eval_mb_size": 1024,
    "train_epochs": 5
  },
  "active_learning": {
    "framework": "bmdal",
    "parameters": {
      "batch_size": 256,
      "max_batch_size": 1024,
      "reload_initial_weights": false,
      "standard_method": "badge",
      "full_first_set": true,
      "first_set_size": 8192,
      "downsampling_factor": 8192
    }
  },
  "dataset": {
    "pow_type": "highpow",
    "cluster_type": "tau_based",
    "dataset_type": "not_null",
    "simulator_type": "qualikiz",
    "input_columns": [
      "ane", "ate", "autor", "machtor", "x",
      "zeff", "gammae", "q", "smag", "alpha",
      "ani1", "ati0", "normni1", "ti_te0", "lognustar"
    ],
    "output_columns": ["efe", "efi", "pfe", "pfi"],
    "input_size": 15,
    "output_size": 4,
    "normalize_inputs": true,
    "normalize_outputs": false,
    "load_saved_final_data": true
  },
  "architecture": {
    "name": "saved",
    "model_folder": "highpow_mlp_256_2_efe_efi_pfe_pfi_8runs",
    "model_name": "model",
    "model_class_name": "MLP",
    "parameters": {
      "input_size": 15,
      "output_size": 4,
      "hidden_size": 256,
      "hidden_layers": 2,
      "drop_rate": 0.5
    }
  },
  "loss": {
    "name": "MSE",
    "parameters": {
      "reduction": "mean"
    }
  },
  "optimizer": {
    "name": "AdamW",
    "parameters": {
      "lr": 2e-3,
      "weight_decay": 1e-5
    }
  },
  "scheduler": {
    "name": "ReduceLROnPlateau",
    "parameters": {
      "metric": "train_loss",
      "first_exp_only": false,
      "factor": 0.5,
      "patience": 21,
      "mode": "min",
      "threshold_mode": "abs",
      "threshold": 1.0,
      "min_lr": 1e-4
    }
  },
  "strategy": [
    {
      "name": "Naive",
      "extra_log_folder": "[test] Base",
      "ignore": false,
      "parameters": {
      }
    },
    {
      "name": "Cumulative",
      "extra_log_folder": "[test] Base",
      "ignore": false,
      "parameters": {
      }
    },
    {
      "name": "Replay",
      "extra_log_folder": "[test] Buffer 2000",
      "ignore": false,
      "parameters": {
        "mem_size": 2000
      }
    },
    {
      "name": "GEM",
      "extra_log_folder": "[test] Patterns 1024",
      "ignore": false,
      "parameters": {
        "patterns_per_exp": 1024
      }
    },
    {
      "name": "EWCReplay",
      "extra_log_folder": "[test] Lambda 1 Buffer 2000",
      "ignore": false,
      "parameters": {
        "mode": "separate",
        "ewc_lambda": 1.0,
        "mem_size": 2000
      }
    }
  ],
  "early_stopping": {
    "patience": 10,
    "delta": 0.1,
    "val_stream_name": "eval_stream",
    "min_epochs": 10
  },
  "validation_stream": {
    "val_stream": "eval_stream"
  },
  "start_model_saving": {
    "save_model": false,
    "saved_model_folder": "highpow_mlp_256_2_efe_efi_pfe_pfi_8runs",
    "saved_model_name": "model",
    "add_timestamp": false
  }
}